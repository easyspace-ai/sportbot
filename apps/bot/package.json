{
  "name": "bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate && bun run --cwd ../../packages/clob-client-v2 build",
    "dev": "bun --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "sync-teams": "ts-node --project tsconfig.scripts.json --transpile-only scripts/syncTeamNames.ts",
    "dryrun-canonicalize": "ts-node --project tsconfig.scripts.json --transpile-only scripts/dryrunCanonicalize.ts"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "file:../../packages/clob-client-v2",
    "axios": "^1.7.9",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/cors": "^2.8.19",
    "centrifuge": "^5.2.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "grammy": "^1.34.0",
    "https-proxy-agent": "^7.0.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^6.25.0",
    "viem": "^2.48.4",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
