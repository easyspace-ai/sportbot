generator client {
  provider = "prisma-client-js"
  // Hoisted monorepo: schema is under apps/bot/prisma → three levels up is repo root.
  // `@prisma/client` loads repo-root `node_modules/.prisma/client` (not only under the package).
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id            String         @id @default(cuid())
  sport         String
  league        String
  homeTeam      String
  awayTeam      String
  startTime     DateTime
  status        String         @default("active")
  sxEventId     String?  // sportXeventId e.g. "L18511902"
  polyEventId   String?  // Polymarket Gamma event id e.g. "341080"
  createdAt     DateTime       @default(now())
  markets       Market[]
  canonicalBets CanonicalBet[]
}

model Market {
  id         String     @id @default(cuid())
  eventId    String
  platform   String     // "sx" | "polymarket"
  externalId String     // marketHash (SX) | event.id (Poly 1x2) | conditionId (Poly spread/total)
  startTime  DateTime   // denormalized from event — used for sort/expiry without joins
  betType    String     @default("1x2") // "1x2" | "12" | "spread" | "total"
  line       Float?     // handicap or total value for spread/total markets
  mainLine   Boolean    @default(true)  // false for alt lines
  status     String     @default("active")
  createdAt  DateTime   @default(now())
  event      Event      @relation(fields: [eventId], references: [id])
  outcomes   Outcome[]
  trades     Trade[]

  @@unique([platform, externalId])
}

model Outcome {
  id              String        @id @default(cuid())
  marketId        String
  label           String
  externalId      String?       // tokenId (Polymarket) | "marketHash:0/1" (SX)
  currentOdds     Float
  liquidityDepth  Float
  liquidityLevels String?       // JSON: Array<{odds: number, size: number}>
  lastUpdated     DateTime      @default(now())
  canonicalBetId  String?
  market          Market        @relation(fields: [marketId], references: [id])
  canonicalBet    CanonicalBet? @relation(fields: [canonicalBetId], references: [id])
  trades          Trade[]
  riskPositions   RiskPosition[]
}

model CanonicalBet {
  id        String    @id @default(cuid())
  eventId   String
  key       String    // e.g. "1x2:home", "spread:home:-1.5", "total:over:2.5"
  betType   String    // "1x2" | "12" | "spread" | "total"
  side      String    // "home" | "away" | "draw" | "over" | "under" | "not_home" | "not_draw" | "not_away"
  line      Float?    // signed home perspective; null for 1x2/12; magnitude for total
  createdAt DateTime  @default(now())
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  outcomes  Outcome[]

  @@unique([eventId, key])
}

model TeamAlias {
  id        String @id @default(cuid())
  canonical String // our normalized name e.g. "Inter Milan"
  platform  String // "sx" | "polymarket"
  alias     String // platform-specific name e.g. "FC Internazionale Milano"
  league    String

  @@unique([platform, alias, league])
}

model Trade {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  marketId      String
  outcomeId     String
  side          String   // "buy" | "sell"
  requestedSize Float
  executedSize  Float?
  requestedOdds Float
  fillOdds      Float?
  platform      String
  txHash        String?
  status        String   // "pending" | "filled" | "failed"
  failureReason String?
  market        Market   @relation(fields: [marketId], references: [id])
  outcome       Outcome  @relation(fields: [outcomeId], references: [id])
}

model BotConfig {
  key   String @id
  value String
}

/**
 * Stored Polymarket CLOB credentials; exactly one row may have `isActive` for trading.
 * CLOB V2 POLY_1271: `funderAddress` is the CREATE2 deposit wallet for the EOA (usually auto-filled when adding via private key only).
 */
model PolymarketAccount {
  id             String   @id @default(cuid())
  name           String
  apiKey         String
  secret         String
  passphrase     String
  privateKey     String
  funderAddress  String
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/** Open Polymarket YES position tracked for dashboard 风控 (bot fills + CLOB user channel / REST sync). */
model RiskPosition {
  id             String   @id @default(cuid())
  platform       String   @default("polymarket")
  /** Set when matched to a synced Outcome row; null for website-only positions not in local DB. */
  outcomeId      String?
  tokenId        String
  title          String
  sideLabel      String
  avgEntryCents  Float
  sizeShares     Float
  costUsd        Float
  highWaterCents Float
  stopLossPct    Float
  /** bot = opened via this router; polymarket_clob = user WS / REST trade sync */
  source         String   @default("bot")
  status         String   @default("open") // open | closing | closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  outcome        Outcome? @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  tasks          RiskTask[]

  @@index([status])
  @@index([tokenId])
}

/** Dedupe Polymarket CLOB trade ids applied to RiskPosition (user channel + REST fallback). */
model RiskAppliedClobTrade {
  id        String   @id
  createdAt DateTime @default(now())
}

/** Retryable stop-loss / manual close jobs (FOK sell with 10-tick slippage floor). */
model RiskTask {
  id         String        @id @default(cuid())
  type       String // close_position | close_all
  positionId String?
  status     String        @default("pending") // pending | running | failed | succeeded
  attempts   Int           @default(0)
  lastError  String?
  nextRunAt  DateTime      @default(now())
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  position   RiskPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt])
}
